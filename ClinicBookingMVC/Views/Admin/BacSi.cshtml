@model IEnumerable<ClinicBookingMVC.Models.Entities.BacSi>
@{
    Layout = "~/Views/Shared/_PortalLayout.cshtml";
    ViewData["Title"] = "Bác sĩ";
    ViewData["ActiveMenu"] = "BacSi";
}

<div class="portal-content__head">
    <div>
        <h1 class="portal-content__title">Quản lý Bác sĩ</h1>
        <p class="portal-content__sub">Tổng cộng @Model.Count() bác sĩ điều trị</p>
    </div>
    <div class="btn-list">
        <a asp-action="TaoBacSi" class="btn btn-primary">+ Thêm bác sĩ mới</a>
    </div>
</div>

@if (TempData["Success"] != null) { <div class="alert alert--success" style="margin-bottom:var(--space-md)">@TempData["Success"]</div> }
@if (TempData["Error"] != null)   { <div class="alert alert--error" style="margin-bottom:var(--space-md)">@TempData["Error"]</div> }

<div class="table-wrap">
    <table class="table">
        <thead>
            <tr>
                <th>Họ tên</th>
                <th>Học vị</th>
                <th>Chuyên khoa</th>
                <th>Tài khoản</th>
                <th>Trạng thái</th>
                <th style="text-align:right">Thao tác</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var bs in Model)
            {
                <tr>
                    <td><strong>@bs.HoTenBacSi</strong></td>
                    <td>@(bs.HocVi ?? "—")</td>
                    <td>@(bs.ChuyenKhoa?.TenChuyenKhoa ?? "—")</td>
                    <td class="font-mono text-muted">@(bs.TaiKhoan?.TenTaiKhoan ?? "—")</td>
                    <td>
                        <span class="badge @(bs.TrangThai == "HoatDong" ? "badge--hoat-dong" : "badge--tam-ngung")">
                            @(bs.TrangThai == "HoatDong" ? "Hoạt động" : "Ngừng")
                        </span>
                    </td>
                    <td style="text-align:right">
                        <div class="btn-list btn-list-end">
                            <a asp-action="SuaBacSi" asp-route-id="@bs.MaBacSi"
                               class="btn btn-sm btn-outline-secondary">Sửa</a>
                            <form method="post" asp-action="XoaBacSi" asp-route-id="@bs.MaBacSi"
                                  style="display:inline;margin:0"
                                  onsubmit="return confirm('Xóa bác sĩ «@bs.HoTenBacSi» và tài khoản liên kết?')">
                                @Html.AntiForgeryToken()
                                <button type="submit" class="btn btn-sm btn-outline-danger">Xóa</button>
                            </form>
                        </div>
                    </td>
                </tr>
            }
            @if (!Model.Any())
            {
                <tr><td colspan="6" style="text-align:center;padding:var(--space-xl);color:var(--color-muted)">Chưa có bác sĩ nào.</td></tr>
            }
        </tbody>
    </table>
</div>
