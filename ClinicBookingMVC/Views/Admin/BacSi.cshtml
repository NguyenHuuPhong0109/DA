@model IEnumerable<ClinicBookingMVC.Models.Entities.BacSi>
@{
    Layout = "~/Views/Shared/_PortalLayout.cshtml";
    ViewData["Title"] = "Bác sĩ";
    ViewData["ActiveMenu"] = "BacSi";
}

<div class="portal-content__head">
    <div>
        <h1 class="portal-content__title">Quản lý Bác sĩ</h1>
        <p class="portal-content__sub">@Model.Count() bác sĩ</p>
    </div>
    <a asp-action="TaoBacSi" class="btn btn--primary">+ Thêm bác sĩ</a>
</div>

@if (TempData["Success"] != null) { <div class="alert alert--success">@TempData["Success"]</div> }
@if (TempData["Error"] != null)   { <div class="alert alert--error">@TempData["Error"]</div> }

<div class="table-wrap">
    <table class="table">
        <thead>
            <tr>
                <th>Họ tên</th>
                <th>Học vị</th>
                <th>Chuyên khoa</th>
                <th>Tài khoản</th>
                <th>Trạng thái</th>
                <th style="width:140px">Thao tác</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var bs in Model)
            {
                <tr>
                    <td>@bs.HoTenBacSi</td>
                    <td>@(bs.HocVi ?? "—")</td>
                    <td>@(bs.ChuyenKhoa?.TenChuyenKhoa ?? "—")</td>
                    <td class="font-mono">@(bs.TaiKhoan?.TenTaiKhoan ?? "—")</td>
                    <td>
                        <span class="badge @(bs.TrangThai == "HoatDong" ? "badge--hoat-dong" : "badge--ngung")">
                            @(bs.TrangThai == "HoatDong" ? "Hoạt động" : "Ngừng")
                        </span>
                    </td>
                    <td class="table-actions">
                        <a asp-action="SuaBacSi" asp-route-id="@bs.MaBacSi"
                           class="btn btn--ghost btn--sm">Sửa</a>
                        <form method="post" asp-action="XoaBacSi" asp-route-id="@bs.MaBacSi"
                              style="display:inline"
                              onsubmit="return confirm('Xóa bác sĩ «@bs.HoTenBacSi» và tài khoản?')">
                            @Html.AntiForgeryToken()
                            <button type="submit" class="btn btn--danger btn--sm">Xóa</button>
                        </form>
                    </td>
                </tr>
            }
            @if (!Model.Any())
            {
                <tr><td colspan="6" class="table-empty">Chưa có bác sĩ nào.</td></tr>
            }
        </tbody>
    </table>
</div>
