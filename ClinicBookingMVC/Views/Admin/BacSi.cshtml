@model IEnumerable<ClinicBookingMVC.Models.Entities.BacSi>
@{
    Layout = "~/Views/Shared/_PortalLayout.cshtml";
    ViewData["Title"] = "Bác sĩ";
    ViewData["ActiveMenu"] = "BacSi";
    var totalCount = Model.Count();
}

<div class="portal-content__head">
    <div>
        <h1 class="portal-content__title">Quản lý Bác sĩ</h1>
        <p class="portal-content__sub">Hiển thị @totalCount bác sĩ điều trị</p>
    </div>
    <div class="btn-list">
        <a asp-action="TaoBacSi" class="btn btn-primary">Thêm bác sĩ</a>
    </div>
</div>

@if (TempData["Success"] != null) { <div class="alert alert--success" style="margin-bottom:var(--space-md)">@TempData["Success"]</div> }
@if (TempData["Error"] != null)   { <div class="alert alert--error" style="margin-bottom:var(--space-md)">@TempData["Error"]</div> }

<!-- Table Toolbar: Tìm kiếm nhanh Client-side -->
<div class="table-toolbar">
    <input type="text" id="searchBox" class="table-search-input" placeholder="Tìm họ tên, chuyên khoa, tài khoản, SĐT..." />
    <span class="text-sm text-muted" id="filterStats">Hiển thị @totalCount dòng</span>
</div>

<div class="card-table">
    <table class="table--clean" id="dataTable">
        <thead>
            <tr>
                <th>Bác sĩ</th>
                <th>Chuyên khoa</th>
                <th>Tài khoản</th>
                <th style="width:160px">Trạng thái</th>
                <th class="th-actions">Thao tác</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var bs in Model)
            {
                var isOpening = (bs.TrangThai == "HoatDong" || bs.TrangThai == "MoKham");

                <tr>
                    <td>
                        <strong>@bs.HoTenBacSi</strong>
                        <span class="sub-info">
                            @(bs.HocVi ?? "Bác sĩ") &middot; <span class="font-mono">@(bs.SoDienThoai ?? "Chưa có SĐT")</span>
                        </span>
                    </td>
                    <td>
                        <span>@(bs.ChuyenKhoa?.TenChuyenKhoa ?? "Chưa phân khoa")</span>
                        <span class="sub-info font-mono">Mã BS: #BS-@bs.MaBacSi.ToString("D3")</span>
                    </td>
                    <td>
                        <span class="font-mono text-muted">@(bs.TaiKhoan?.TenTaiKhoan ?? "—")</span>
                    </td>
                    <td>
                        <span class="status-dot @(isOpening ? "status-dot--success" : "status-dot--muted")"></span>
                        @(isOpening ? "Hoạt động" : "Tạm ngưng")
                    </td>
                    <td class="td-actions">
                        <div class="actions-wrap">
                            <a asp-action="SuaBacSi" asp-route-id="@bs.MaBacSi"
                               class="btn btn-sm btn-outline-secondary">Sửa</a>
                            <form method="post" asp-action="XoaBacSi" asp-route-id="@bs.MaBacSi"
                                  onsubmit="return confirm('Xóa bác sĩ «@bs.HoTenBacSi» và tài khoản liên kết?')">
                                @Html.AntiForgeryToken()
                                <button type="submit" class="btn btn-sm btn-outline-danger">Xóa</button>
                            </form>
                        </div>
                    </td>
                </tr>
            }
            @if (!Model.Any())
            {
                <tr id="emptyRow">
                    <td colspan="5" style="text-align:center;padding:36px;color:#6B7280">
                        Chưa có bác sĩ nào trong hệ thống.
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>

@section Scripts {
<script>
document.addEventListener("DOMContentLoaded", function () {
    const searchBox = document.getElementById("searchBox");
    const dataTable = document.getElementById("dataTable");
    const filterStats = document.getElementById("filterStats");
    if (!searchBox || !dataTable) return;

    const rows = dataTable.querySelectorAll("tbody tr:not(#emptyRow)");

    searchBox.addEventListener("input", function () {
        const query = this.value.trim().toLowerCase();
        let visibleCount = 0;

        rows.forEach(row => {
            const text = row.textContent.toLowerCase();
            if (text.includes(query)) {
                row.style.display = "";
                visibleCount++;
            } else {
                row.style.display = "none";
            }
        });

        if (filterStats) {
            filterStats.textContent = `Hiển thị ${visibleCount} / ${rows.length} dòng`;
        }
    });
});
</script>
}
