@model IEnumerable<ClinicBookingMVC.Models.Entities.PhongKham>
@{
    Layout = "~/Views/Shared/_PortalLayout.cshtml";
    ViewData["Title"] = "Phòng khám";
    ViewData["ActiveMenu"] = "PhongKham";
}

<div class="portal-content__head">
    <div>
        <h1 class="portal-content__title">Quản lý Phòng khám</h1>
        <p class="portal-content__sub">Tổng cộng @Model.Count() phòng khám</p>
    </div>
    <div class="btn-list">
        <a asp-action="TaoPhongKham" class="btn btn-primary">+ Thêm phòng khám</a>
    </div>
</div>

@if (TempData["Success"] != null) { <div class="alert alert--success" style="margin-bottom:var(--space-md)">@TempData["Success"]</div> }
@if (TempData["Error"] != null)   { <div class="alert alert--error" style="margin-bottom:var(--space-md)">@TempData["Error"]</div> }

<div class="table-wrap">
    <table class="table">
        <thead>
            <tr>
                <th class="font-mono" style="width:70px">Mã phòng</th>
                <th>Tên phòng</th>
                <th>Vị trí</th>
                <th>Chuyên khoa</th>
                <th>Trạng thái</th>
                <th style="text-align:right">Thao tác</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var p in Model)
            {
                <tr>
                    <td class="font-mono">#@p.MaPhong</td>
                    <td><strong>@p.TenPhong</strong></td>
                    <td class="text-muted text-sm">@(p.ViTri ?? "—")</td>
                    <td>@(p.ChuyenKhoa?.TenChuyenKhoa ?? "—")</td>
                    <td>
                        <span class="badge @(p.TrangThai == "HoatDong" ? "badge--hoat-dong" : "badge--tam-ngung")">
                            @(p.TrangThai == "HoatDong" ? "Hoạt động" : "Ngừng")
                        </span>
                    </td>
                    <td style="text-align:right">
                        <div class="btn-list btn-list-end">
                            <a asp-action="SuaPhongKham" asp-route-id="@p.MaPhong"
                               class="btn btn-sm btn-outline-secondary">Sửa</a>
                            <form method="post" asp-action="XoaPhongKham" asp-route-id="@p.MaPhong"
                                  style="display:inline;margin:0"
                                  onsubmit="return confirm('Xóa phòng «@p.TenPhong»?')">
                                @Html.AntiForgeryToken()
                                <button type="submit" class="btn btn-sm btn-outline-danger">Xóa</button>
                            </form>
                        </div>
                    </td>
                </tr>
            }
            @if (!Model.Any())
            {
                <tr><td colspan="6" style="text-align:center;padding:var(--space-xl);color:var(--color-muted)">Chưa có phòng khám nào.</td></tr>
            }
        </tbody>
    </table>
</div>
