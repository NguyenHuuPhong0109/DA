@model ClinicBookingMVC.Models.Entities.CaTruc
@{
    Layout = "~/Views/Shared/_PortalLayout.cshtml";
    ViewData["Title"] = "Chi tiết Khung giờ làm việc";
    ViewData["ActiveMenu"] = "CaTruc";
    var slots = Model.KhungGios.OrderBy(k => k.GioBatDau).ToList();
    var totalSlots = slots.Count;
    var caLamViecText = Model.CaLamViec switch {
        "Sang"  => "Ca sáng",
        "Chieu" => "Ca chiều",
        "Toi"   => "Ca tối",
        _       => Model.CaLamViec
    };
}

<div class="portal-content__head">
    <div>
        <h1 class="portal-content__title">Khung giờ — @caLamViecText</h1>
        <p class="portal-content__sub">
            <strong>@(Model.BacSi?.HoTenBacSi)</strong> &middot;
            @(Model.PhongKham?.TenPhong) &middot;
            <span class="font-mono">@Model.NgayTruc.ToString("dd/MM/yyyy")</span>
            (@Model.GioBatDauCa.ToString("HH:mm") – @Model.GioKetThucCa.ToString("HH:mm"))
        </p>
    </div>
    <div class="btn-list">
        <a asp-action="CaTruc" asp-route-ngay="@Model.NgayTruc.ToString("yyyy-MM-dd")"
           class="btn btn-outline-secondary">Danh sách lịch làm việc</a>
    </div>
</div>

@if (TempData["Success"] != null) { <div class="alert alert--success" style="margin-bottom:var(--space-md)">@TempData["Success"]</div> }
@if (TempData["Error"] != null)   { <div class="alert alert--error" style="margin-bottom:var(--space-md)">@TempData["Error"]</div> }

<!-- Table Toolbar: Lọc nhanh theo trạng thái slot -->
<div class="table-toolbar">
    <div class="btn-list" style="align-items:center;gap:6px">
        <span style="font-size:12px;font-weight:600;color:#6B7280;margin-right:2px">Bộ lọc slot:</span>
        <button type="button" class="btn btn-sm btn-primary slot-filter-btn" data-filter="all">Tất cả (@totalSlots)</button>
        <button type="button" class="btn btn-sm btn-outline-secondary slot-filter-btn" data-filter="ConTrong">
            Còn trống (@slots.Count(s => s.TrangThai == "ConTrong"))
        </button>
        <button type="button" class="btn btn-sm btn-outline-secondary slot-filter-btn" data-filter="DaDat">
            Đã đặt (@slots.Count(s => s.TrangThai == "DaDat"))
        </button>
        <button type="button" class="btn btn-sm btn-outline-secondary slot-filter-btn" data-filter="TamKhoa">
            Tạm khóa (@slots.Count(s => s.TrangThai == "TamKhoa"))
        </button>
        <button type="button" class="btn btn-sm btn-outline-secondary slot-filter-btn" data-filter="KhungDem">
            Khung đệm (@slots.Count(s => s.LoaiKhungGio == "KhungDem"))
        </button>
    </div>
    <span class="text-sm text-muted" id="slotFilterStats">Hiển thị @totalSlots slots</span>
</div>

<!-- Grid danh sách khung giờ -->
<div class="schedule-grid" id="slotsGrid">
    @foreach (var kg in slots)
    {
        var slotClass = kg.LoaiKhungGio == "KhungDem"  ? "sched-slot sched-slot--buffer" :
                        kg.TrangThai    == "DaDat"     ? "sched-slot sched-slot--taken"  :
                        kg.TrangThai    == "TamKhoa"   ? "sched-slot sched-slot--locked" : "sched-slot";

        var dotClass = kg.TrangThai switch {
            "ConTrong" => "status-dot--success",
            "DaDat"    => "status-dot--muted",
            "TamKhoa"  => "status-dot--danger",
            _          => "status-dot--muted"
        };
        var trangThaiText = kg.TrangThai switch {
            "ConTrong" => "Còn trống",
            "DaDat"    => "Đã đặt",
            "TamKhoa"  => "Tạm khóa",
            _          => kg.TrangThai
        };

        <div class="@slotClass slot-card-item"
             data-status="@kg.TrangThai"
             data-type="@kg.LoaiKhungGio"
             style="background:#ffffff;border:1px solid #E5E7EB;border-radius:8px;padding:12px;box-shadow:0 1px 2px rgba(0,0,0,0.05);display:flex;flex-direction:column;justify-content:space-between">
            <div>
                <div class="sched-slot__time font-mono" style="font-weight:600;font-size:14px;color:#111827">
                    @kg.GioBatDau.ToString("HH:mm") – @kg.GioKetThuc.ToString("HH:mm")
                </div>
                <div class="sched-slot__type" style="font-size:12px;color:#6B7280;margin:3px 0 6px">
                    @(kg.LoaiKhungGio == "KhungDem" ? "Khung đệm (Walk-in)" : "Đặt hẹn trước")
                </div>
                <div style="margin-bottom:10px;font-size:12px;color:#374151">
                    <span class="status-dot @dotClass"></span>@trangThaiText
                </div>
            </div>
            @if (kg.TrangThai == "ConTrong")
            {
                <div style="margin-top:auto">
                    <form method="post" asp-action="KhoaKhungGio" style="display:inline-flex;width:100%;margin:0">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="id"   value="@kg.MaKhungGio" />
                        <input type="hidden" name="maCa" value="@Model.MaCa" />
                        <button type="submit" class="btn btn-sm btn-outline-danger" style="width:100%">Khóa slot</button>
                    </form>
                </div>
            }
            else if (kg.TrangThai == "TamKhoa")
            {
                <div style="margin-top:auto">
                    <form method="post" asp-action="MoKhungGio" style="display:inline-flex;width:100%;margin:0">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="id"   value="@kg.MaKhungGio" />
                        <input type="hidden" name="maCa" value="@Model.MaCa" />
                        <button type="submit" class="btn btn-sm btn-outline-secondary" style="width:100%">Mở khóa</button>
                    </form>
                </div>
            }
            else
            {
                <div style="margin-top:auto">
                    <span class="text-xs text-muted" style="display:block;text-align:center;padding:4px 0">Đã khóa lịch</span>
                </div>
            }
        </div>
    }
    @if (!slots.Any())
    {
        <div class="card" style="grid-column:1/-1;text-align:center;padding:36px;color:#6B7280;background:#ffffff;border:1px solid #E5E7EB">
            Ca trực chưa có khung giờ nào được khởi tạo.
        </div>
    }
</div>

@section Scripts {
<script>
document.addEventListener("DOMContentLoaded", function () {
    const filterBtns = document.querySelectorAll(".slot-filter-btn");
    const slotCards = document.querySelectorAll(".slot-card-item");
    const statsEl = document.getElementById("slotFilterStats");

    filterBtns.forEach(btn => {
        btn.addEventListener("click", function () {
            filterBtns.forEach(b => {
                b.classList.remove("btn-primary");
                b.classList.add("btn-outline-secondary");
            });
            this.classList.remove("btn-outline-secondary");
            this.classList.add("btn-primary");

            const filter = this.getAttribute("data-filter");
            let count = 0;

            slotCards.forEach(card => {
                const status = card.getAttribute("data-status");
                const type = card.getAttribute("data-type");

                let match = false;
                if (filter === "all") match = true;
                else if (filter === "KhungDem") match = (type === "KhungDem");
                else match = (status === filter);

                if (match) {
                    card.style.display = "";
                    count++;
                } else {
                    card.style.display = "none";
                }
            });

            if (statsEl) {
                statsEl.textContent = `Hiển thị ${count} / ${slotCards.length} slots`;
            }
        });
    });
});
</script>
}
