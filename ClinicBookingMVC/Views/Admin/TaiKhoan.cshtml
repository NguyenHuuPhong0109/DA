@model IEnumerable<ClinicBookingMVC.Models.Entities.TaiKhoan>
@{
    Layout = "~/Views/Shared/_PortalLayout.cshtml";
    ViewData["Title"] = "Tài khoản";
    ViewData["ActiveMenu"] = "TaiKhoan";
}

<div class="portal-content__head">
    <div>
        <h1 class="portal-content__title">Quản lý Tài khoản</h1>
        <p class="portal-content__sub">Tổng cộng @Model.Count() tài khoản người dùng</p>
    </div>
    <div class="btn-list">
        <a asp-action="TaoTaiKhoan" class="btn btn-primary">+ Tạo tài khoản mới</a>
    </div>
</div>

@if (TempData["Success"] != null) { <div class="alert alert--success" style="margin-bottom:var(--space-md)">@TempData["Success"]</div> }
@if (TempData["Error"] != null)   { <div class="alert alert--error" style="margin-bottom:var(--space-md)">@TempData["Error"]</div> }

<div class="table-wrap">
    <table class="table">
        <thead>
            <tr>
                <th>Tên tài khoản</th>
                <th>Số điện thoại</th>
                <th>Vai trò</th>
                <th>Trạng thái</th>
                <th style="text-align:right">Thao tác</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var tk in Model)
            {
                <tr>
                    <td class="font-mono"><strong>@tk.TenTaiKhoan</strong></td>
                    <td class="font-mono">@(tk.SoDienThoai ?? "—")</td>
                    <td>
                        <span class="badge badge--cho-xac-nhan">@(tk.VaiTro?.TenVaiTro ?? "—")</span>
                    </td>
                    <td>
                        <span class="badge @(tk.TrangThai == "HoatDong" ? "badge--hoat-dong" : "badge--tam-khoa")">
                            @(tk.TrangThai == "HoatDong" ? "Hoạt động" : "Bị khóa")
                        </span>
                    </td>
                    <td style="text-align:right">
                        @if (tk.TenTaiKhoan == "admin")
                        {
                            <span class="text-muted text-xs">Admin gốc</span>
                        }
                        else if (tk.TrangThai == "HoatDong")
                        {
                            <form method="post" asp-action="KhoaTaiKhoan" asp-route-id="@tk.MaTaiKhoan"
                                  style="display:inline;margin:0"
                                  onsubmit="return confirm('Khóa tài khoản «@tk.TenTaiKhoan»?')">
                                @Html.AntiForgeryToken()
                                <button type="submit" class="btn btn-sm btn-outline-danger">Khóa</button>
                            </form>
                        }
                        else
                        {
                            <form method="post" asp-action="MoKhoaTaiKhoan" asp-route-id="@tk.MaTaiKhoan"
                                  style="display:inline;margin:0">
                                @Html.AntiForgeryToken()
                                <button type="submit" class="btn btn-sm btn-outline-secondary">Mở khóa</button>
                            </form>
                        }
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>
