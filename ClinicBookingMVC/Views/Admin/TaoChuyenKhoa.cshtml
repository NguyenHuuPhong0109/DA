@model ClinicBookingMVC.Models.ViewModels.ChuyenKhoaVM
@{
    Layout = "~/Views/Shared/_PortalLayout.cshtml";
    ViewData["Title"] = "Thêm Chuyên khoa";
    ViewData["ActiveMenu"] = "ChuyenKhoa";
}

<div class="portal-content__head">
    <div>
        <h1 class="portal-content__title">Thêm Chuyên khoa mới</h1>
        <p class="portal-content__sub">Tạo chuyên khoa khám bệnh cho phòng khám</p>
    </div>
    <div class="btn-list">
        <a asp-action="ChuyenKhoa" class="btn btn-outline-secondary">← Quay lại</a>
    </div>
</div>

<div class="card" style="max-width:640px">
    <form method="post" asp-action="TaoChuyenKhoa" novalidate>
        @Html.AntiForgeryToken()
        <div class="form-group">
            <label asp-for="TenChuyenKhoa" class="form-label"></label>
            <input asp-for="TenChuyenKhoa" class="form-control"
                   placeholder="VD: Tim mạch, Nội tổng hợp..." />
            <span asp-validation-for="TenChuyenKhoa" class="field-validation-error"></span>
        </div>
        <div class="form-group">
            <label asp-for="MoTa" class="form-label"></label>
            <textarea asp-for="MoTa" class="form-control" rows="3"
                      placeholder="Mô tả tóm tắt dịch vụ của chuyên khoa..."></textarea>
        </div>
        <div class="form-group">
            <label asp-for="TrangThai" class="form-label"></label>
            <select asp-for="TrangThai" class="form-control">
                <option value="HoatDong">Hoạt động</option>
                <option value="NgungHoatDong">Ngừng hoạt động</option>
            </select>
        </div>
        <div class="btn-list" style="margin-top:var(--space-lg)">
            <button type="submit" class="btn btn-primary">Lưu chuyên khoa</button>
            <a asp-action="ChuyenKhoa" class="btn btn-outline-secondary">Hủy</a>
        </div>
    </form>
</div>

@section Scripts { <partial name="_ValidationScriptsPartial" /> }
