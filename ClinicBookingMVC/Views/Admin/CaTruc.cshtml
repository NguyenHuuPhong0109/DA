@model IEnumerable<ClinicBookingMVC.Models.Entities.CaTruc>
@{
    Layout = "~/Views/Shared/_PortalLayout.cshtml";
    ViewData["Title"] = "Ca trực";
    ViewData["ActiveMenu"] = "CaTruc";
    var ngayFilter = (DateOnly)ViewBag.NgayFilter;
}

<div class="portal-content__head">
    <div>
        <h1 class="portal-content__title">Quản lý Ca trực</h1>
        <p class="portal-content__sub">@ngayFilter.ToString("dd/MM/yyyy")</p>
    </div>
    <a asp-action="TaoCaTruc" class="btn btn--primary">+ Tạo ca trực</a>
</div>

@if (TempData["Success"] != null) { <div class="alert alert--success">@TempData["Success"]</div> }
@if (TempData["Error"] != null)   { <div class="alert alert--error">@TempData["Error"]</div> }

<form method="get" class="filter-bar">
    <div class="form-group form-group--inline">
        <label class="form-label">Lọc ngày</label>
        <input type="date" name="ngay" class="form-control font-mono"
               value="@ngayFilter.ToString("yyyy-MM-dd")" />
        <button type="submit" class="btn btn--ghost">Lọc</button>
    </div>
</form>

<div class="table-wrap">
    <table class="table">
        <thead>
            <tr>
                <th>Bác sĩ</th>
                <th>Phòng</th>
                <th>Ngày</th>
                <th>Ca</th>
                <th>Giờ</th>
                <th>Trạng thái</th>
                <th style="width:160px">Thao tác</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var ca in Model)
            {
                <tr>
                    <td>@(ca.BacSi?.HoTenBacSi ?? "—")</td>
                    <td>@(ca.PhongKham?.TenPhong ?? "—")</td>
                    <td class="font-mono">@ca.NgayTruc.ToString("dd/MM/yyyy")</td>
                    <td>@ca.CaLamViec</td>
                    <td class="font-mono">
                        @ca.GioBatDauCa.ToString("HH:mm") – @ca.GioKetThucCa.ToString("HH:mm")
                    </td>
                    <td>
                        <span class="badge badge--hoat-dong">@ca.TrangThaiCa</span>
                    </td>
                    <td class="table-actions">
                        <a asp-action="KhungGioDetail" asp-route-id="@ca.MaCa"
                           class="btn btn--ghost btn--sm">Khung giờ</a>
                        <form method="post" asp-action="XoaCaTruc" asp-route-id="@ca.MaCa"
                              style="display:inline"
                              onsubmit="return confirm('Xóa ca trực này và toàn bộ khung giờ?')">
                            @Html.AntiForgeryToken()
                            <button type="submit" class="btn btn--danger btn--sm">Xóa</button>
                        </form>
                    </td>
                </tr>
            }
            @if (!Model.Any())
            {
                <tr>
                    <td colspan="7" class="table-empty">
                        Không có ca trực nào ngày @ngayFilter.ToString("dd/MM/yyyy").
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>
