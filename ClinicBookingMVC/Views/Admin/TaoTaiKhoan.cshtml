@model ClinicBookingMVC.Models.ViewModels.TaoTaiKhoanVM
@{
    Layout = "~/Views/Shared/_PortalLayout.cshtml";
    ViewData["Title"] = "Tạo Tài khoản";
    ViewData["ActiveMenu"] = "TaiKhoan";
    var nhomHienTai = (string?)ViewBag.NhomHienTai;
}

<div class="portal-content__head">
    <div>
        <h1 class="portal-content__title">Tạo Tài khoản mới</h1>
        <p class="portal-content__sub">Thêm người dùng mới vào hệ thống quản lý</p>
    </div>
    <div class="btn-list">
        <a asp-action="TaiKhoan" asp-route-nhom="@nhomHienTai" class="btn btn-outline-secondary">Quay lại</a>
    </div>
</div>

<div class="card" style="max-width:640px;background:#ffffff;border:1px solid #E5E7EB;border-radius:8px;padding:24px;box-shadow:0 1px 2px rgba(0,0,0,0.05)">
    <form method="post" asp-action="TaoTaiKhoan" asp-route-nhom="@nhomHienTai" novalidate>
        @Html.AntiForgeryToken()
        <div class="form-group" style="margin-bottom:16px">
            <label asp-for="TenTaiKhoan" class="form-label" style="font-weight:600;font-size:13px;color:#374151">Tên tài khoản</label>
            <input asp-for="TenTaiKhoan" class="form-control"
                   placeholder="Nhập tên tài khoản (ít nhất 4 ký tự)" autocomplete="off" style="height:36px" />
            <span asp-validation-for="TenTaiKhoan" class="field-validation-error"></span>
        </div>
        <div class="form-group" style="margin-bottom:16px">
            <label asp-for="SoDienThoai" class="form-label" style="font-weight:600;font-size:13px;color:#374151">Số điện thoại</label>
            <input asp-for="SoDienThoai" class="form-control font-mono" placeholder="Nhập số điện thoại 10 số" style="height:36px" />
            <span asp-validation-for="SoDienThoai" class="field-validation-error"></span>
        </div>
        <div class="form-group" style="margin-bottom:16px">
            <label asp-for="MatKhau" class="form-label" style="font-weight:600;font-size:13px;color:#374151">Mật khẩu</label>
            <input asp-for="MatKhau" class="form-control"
                   placeholder="Nhập mật khẩu (ít nhất 6 ký tự)" autocomplete="new-password" style="height:36px" />
            <span asp-validation-for="MatKhau" class="field-validation-error"></span>
        </div>
        <div class="form-group" style="margin-bottom:20px">
            <label asp-for="MaVaiTro" class="form-label" style="font-weight:600;font-size:13px;color:#374151">Vai trò</label>
            <select asp-for="MaVaiTro" asp-items="ViewBag.VaiTroList" class="form-control" style="height:36px">
                <option value="">-- Chọn vai trò --</option>
            </select>
            <span asp-validation-for="MaVaiTro" class="field-validation-error"></span>
        </div>
        <div class="btn-list" style="margin-top:24px;gap:8px">
            <button type="submit" class="btn btn-primary">Tạo tài khoản</button>
            <a asp-action="TaiKhoan" asp-route-nhom="@nhomHienTai" class="btn btn-outline-secondary">Hủy</a>
        </div>
    </form>
</div>

@section Scripts { <partial name="_ValidationScriptsPartial" /> }
