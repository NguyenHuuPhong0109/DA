@model ClinicBookingMVC.Models.ViewModels.TaoBacSiVM
@{
    Layout = "~/Views/Shared/_PortalLayout.cshtml";
    ViewData["Title"] = "Thêm Bác sĩ";
    ViewData["ActiveMenu"] = "BacSi";
}

<div class="portal-content__head">
    <div><h1 class="portal-content__title">Thêm Bác sĩ</h1></div>
    <a asp-action="BacSi" class="btn btn--ghost">← Quay lại</a>
</div>

<div class="form-card">
    <form method="post" asp-action="TaoBacSi" novalidate>
        @Html.AntiForgeryToken()

        <fieldset class="form-section">
            <legend class="form-section__title">Thông tin bác sĩ</legend>
            <div class="form-row-2">
                <div class="form-group">
                    <label asp-for="HoTenBacSi" class="form-label"></label>
                    <input asp-for="HoTenBacSi" class="form-control" placeholder="BS. Nguyễn Văn A" />
                    <span asp-validation-for="HoTenBacSi" class="form-error"></span>
                </div>
                <div class="form-group">
                    <label asp-for="HocVi" class="form-label"></label>
                    <input asp-for="HocVi" class="form-control" placeholder="ThS., TS., PGS.TS." />
                </div>
            </div>
            <div class="form-row-2">
                <div class="form-group">
                    <label asp-for="SoDienThoai" class="form-label"></label>
                    <input asp-for="SoDienThoai" class="form-control" placeholder="0901234567" />
                    <span asp-validation-for="SoDienThoai" class="form-error"></span>
                </div>
                <div class="form-group">
                    <label asp-for="MaChuyenKhoa" class="form-label"></label>
                    <select asp-for="MaChuyenKhoa" asp-items="ViewBag.ChuyenKhoaList" class="form-control">
                        <option value="">-- Chọn chuyên khoa --</option>
                    </select>
                    <span asp-validation-for="MaChuyenKhoa" class="form-error"></span>
                </div>
            </div>
        </fieldset>

        <fieldset class="form-section">
            <legend class="form-section__title">Tài khoản đăng nhập</legend>
            <div class="form-group">
                <label asp-for="TenTaiKhoan" class="form-label"></label>
                <input asp-for="TenTaiKhoan" class="form-control"
                       placeholder="VD: bs.nguyenvana" autocomplete="off" />
                <span asp-validation-for="TenTaiKhoan" class="form-error"></span>
            </div>
            <div class="form-group">
                <label asp-for="MatKhau" class="form-label"></label>
                <input asp-for="MatKhau" class="form-control"
                       placeholder="Ít nhất 6 ký tự" autocomplete="new-password" />
                <span asp-validation-for="MatKhau" class="form-error"></span>
            </div>
        </fieldset>

        <div class="form-actions">
            <button type="submit" class="btn btn--primary">Tạo bác sĩ</button>
            <a asp-action="BacSi" class="btn btn--ghost">Hủy</a>
        </div>
    </form>
</div>

@section Scripts { <partial name="_ValidationScriptsPartial" /> }
