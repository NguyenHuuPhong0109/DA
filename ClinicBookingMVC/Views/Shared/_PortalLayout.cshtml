<!DOCTYPE html>
<html lang="vi" data-portal="internal">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>@ViewData["Title"] — Quản trị Phòng Khám</title>
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin="anonymous" />
  <link rel="stylesheet" href="~/css/clinic.css" asp-append-version="true" />
  <link rel="stylesheet" href="~/css/clinic-phase5.css" asp-append-version="true" />
  @await RenderSectionAsync("Styles", required: false)
</head>
<body>
  <a class="skip-link" href="#main-content">Bỏ qua điều hướng</a>

  <!-- Lớp phủ mờ (Backdrop) khi mở menu trên thiết bị di động -->
  <div class="portal-backdrop" id="portalBackdrop" aria-hidden="true"></div>

  <div class="portal-wrap">
    <!-- ── Sidebar (Ngăn kéo trượt trên Mobile < 992px) ── -->
    <aside class="portal-sidebar" id="portalSidebar" aria-label="Menu nội bộ">
      <div class="portal-sidebar__head">
        <a class="portal-sidebar__brand" asp-controller="Home" asp-action="Index">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M22 12h-4l-3 9L9 3l-3 9H2"/></svg>
          Phòng Khám Đa Khoa
        </a>
        <button type="button" class="portal-sidebar__close" id="portalSidebarClose" aria-label="Đóng menu">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
        </button>
      </div>

      <nav aria-label="Điều hướng nội bộ">
        <ul class="sidebar-nav" role="list">
          @{
            var ctrl = ViewContext.RouteData.Values["controller"]?.ToString() ?? "";
            var act  = ViewContext.RouteData.Values["action"]?.ToString() ?? "";
          }

          @if (User.IsInRole("Admin") || User.IsInRole("LeTan"))
          {
            <li class="sidebar-nav__section">Lễ tân</li>
            <li>
              <a asp-controller="LeTan" asp-action="Index" class="@(ctrl == "LeTan" ? "is-active" : "")">
                <svg viewBox="0 0 24 24"><rect x="3" y="3" width="7" height="7"/><rect x="14" y="3" width="7" height="7"/><rect x="3" y="14" width="7" height="7"/><rect x="14" y="14" width="7" height="7"/></svg>
                Hàng đợi hôm nay
              </a>
            </li>
          }

          @if (User.IsInRole("BacSi"))
          {
            <li class="sidebar-nav__section">Bác sĩ</li>
            <li>
              <a asp-controller="BacSi" asp-action="Index" class="@(ctrl == "BacSi" ? "is-active" : "")">
                <svg viewBox="0 0 24 24"><path d="M20 7H4a2 2 0 0 0-2 2v6a2 2 0 0 0 2 2h16a2 2 0 0 0 2-2V9a2 2 0 0 0-2-2z"/><line x1="12" y1="12" x2="12" y2="12.01"/></svg>
                Lịch trực của tôi
              </a>
            </li>
          }

          @if (User.IsInRole("Admin"))
          {
            <li class="sidebar-nav__section">Vận hành</li>
            <li>
              <a asp-controller="Admin" asp-action="Index" class="@(ctrl == "Admin" && act == "Index" ? "is-active" : "")">
                <svg viewBox="0 0 24 24"><path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/><polyline points="9 22 9 12 15 12 15 22"/></svg>
                Tổng quan (Dashboard)
              </a>
            </li>
            <li>
              <a asp-controller="Admin" asp-action="CaTruc" class="@(ctrl == "Admin" && (act.Contains("CaTruc") || act.Contains("KhungGio")) ? "is-active" : "")">
                <svg viewBox="0 0 24 24"><rect x="3" y="4" width="18" height="18" rx="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/></svg>
                Lịch làm việc
              </a>
            </li>

            <li class="sidebar-nav__section">Danh mục cơ sở</li>
            <li>
              <a asp-controller="Admin" asp-action="ChuyenKhoa" class="@(ctrl == "Admin" && act.Contains("ChuyenKhoa") ? "is-active" : "")">
                <svg viewBox="0 0 24 24"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="16"/><line x1="8" y1="12" x2="16" y2="12"/></svg>
                Chuyên khoa
              </a>
            </li>
            <li>
              <a asp-controller="Admin" asp-action="PhongKham" class="@(ctrl == "Admin" && act.Contains("PhongKham") ? "is-active" : "")">
                <svg viewBox="0 0 24 24"><rect x="2" y="3" width="20" height="14" rx="2"/><line x1="8" y1="21" x2="16" y2="21"/><line x1="12" y1="17" x2="12" y2="21"/></svg>
                Phòng khám
              </a>
            </li>
            <li>
              <a asp-controller="Admin" asp-action="BacSi" class="@(ctrl == "Admin" && act.Contains("BacSi") ? "is-active" : "")">
                <svg viewBox="0 0 24 24"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>
                Bác sĩ
              </a>
            </li>

            <li class="sidebar-nav__section">Quản lý tài khoản</li>
            <li>
              <a asp-controller="Admin" asp-action="TaiKhoan" asp-route-nhom="NhanSu" class="@(ctrl == "Admin" && act.Contains("TaiKhoan") && (Context.Request.Query["nhom"] == "NhanSu" || string.IsNullOrEmpty(Context.Request.Query["nhom"])) ? "is-active" : "")">
                <svg viewBox="0 0 24 24"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>
                Bác sĩ &amp; Lễ tân
              </a>
            </li>
            <li>
              <a asp-controller="Admin" asp-action="TaiKhoan" asp-route-nhom="BenhNhan" class="@(ctrl == "Admin" && act.Contains("TaiKhoan") && Context.Request.Query["nhom"] == "BenhNhan" ? "is-active" : "")">
                <svg viewBox="0 0 24 24"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>
                Bệnh nhân
              </a>
            </li>
          }
        </ul>
      </nav>

      <div class="portal-sidebar__foot">
        @{
          var userName  = User.Identity?.Name ?? "Người dùng";
          var userRole  = User.Claims.FirstOrDefault(c => c.Type == System.Security.Claims.ClaimTypes.Role)?.Value ?? "";
          var roleLabel = userRole switch {
            "Admin"    => "Quản trị viên",
            "LeTan"    => "Lễ tân",
            "BacSi"    => "Bác sĩ",
            "BenhNhan" => "Bệnh nhân",
            _          => userRole
          };
          var parts    = userName.Split(' ', StringSplitOptions.RemoveEmptyEntries);
          var initials = string.Concat(parts.Select(w => w[0])).ToUpper();
          if (initials.Length > 2) initials = initials[..2];
        }
        <div class="sidebar-user">
          <div class="sidebar-user__avatar" aria-hidden="true">@initials</div>
          <div>
            <div class="sidebar-user__name">@userName</div>
            <div class="sidebar-user__role">@roleLabel</div>
          </div>
        </div>
        <div style="margin-top:var(--space-md)">
          <form asp-controller="TaiKhoan" asp-action="DangXuat" method="post">
            @Html.AntiForgeryToken()
            <button type="submit" class="btn btn-outline-danger" style="width:100%;justify-content:center;min-height:40px;font-weight:600">
              Đăng xuất
            </button>
          </form>
        </div>
      </div>
    </aside>

    <!-- ── Main area ── -->
    <div class="portal-main">
      <header class="portal-topbar">
        <div style="display:flex;align-items:center;gap:var(--space-sm)">
          <button type="button" class="portal-mobile-toggle" id="portalMobileToggle" aria-label="Mở menu quản trị">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><line x1="3" y1="12" x2="21" y2="12"/><line x1="3" y1="6" x2="21" y2="6"/><line x1="3" y1="18" x2="21" y2="18"/></svg>
          </button>
          <div class="portal-topbar__breadcrumb">
            @if (ViewData["Breadcrumb"] != null)
            {
              @Html.Raw(ViewData["Breadcrumb"])
            }
            else
            {
              <span>@ViewData["Title"]</span>
            }
          </div>
        </div>
        <div style="display:flex;align-items:center;gap:var(--space-sm)">
          <span class="text-sm text-muted fig">@DateTime.Now.ToString("dd/MM/yyyy")</span>
        </div>
      </header>

      <main class="portal-content" id="main-content" style="max-width: 1360px; margin: 0 auto; width: 100%;">
        @if (TempData["SuccessMessage"] != null)
        {
          <div class="alert alert--success" role="alert" style="margin-bottom:var(--space-lg)">
            <svg width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true"><polyline points="20 6 9 17 4 12"/></svg>
            <span>@TempData["SuccessMessage"]</span>
          </div>
        }
        @if (TempData["ErrorMessage"] != null)
        {
          <div class="alert alert--error" role="alert" style="margin-bottom:var(--space-lg)">
            <svg width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/></svg>
            <span>@TempData["ErrorMessage"]</span>
          </div>
        }
        @RenderBody()
      </main>
    </div>
  </div>

  <script src="~/lib/jquery/dist/jquery.min.js"></script>
  <script src="~/lib/jquery-validation/dist/jquery.validate.min.js"></script>
  <script src="~/lib/jquery-validation-unobtrusive/dist/jquery.validate.unobtrusive.min.js"></script>
  <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
  <script>
    // ── Xử lý Drawer / Offcanvas menu trên Mobile (< 992px) ──
    const _portalToggleBtn = document.getElementById('portalMobileToggle');
    const _portalCloseBtn  = document.getElementById('portalSidebarClose');
    const _portalSidebar   = document.getElementById('portalSidebar');
    const _portalBackdrop  = document.getElementById('portalBackdrop');

    function _openMobileSidebar() {
      if (_portalSidebar) _portalSidebar.classList.add('is-open');
      if (_portalBackdrop) _portalBackdrop.classList.add('is-open');
      document.body.style.overflow = 'hidden';
    }

    function _closeMobileSidebar() {
      if (_portalSidebar) _portalSidebar.classList.remove('is-open');
      if (_portalBackdrop) _portalBackdrop.classList.remove('is-open');
      document.body.style.overflow = '';
    }

    if (_portalToggleBtn) _portalToggleBtn.addEventListener('click', _openMobileSidebar);
    if (_portalCloseBtn)  _portalCloseBtn.addEventListener('click', _closeMobileSidebar);
    if (_portalBackdrop)  _portalBackdrop.addEventListener('click', _closeMobileSidebar);
  </script>
  @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
