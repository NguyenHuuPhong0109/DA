@{
    ViewData["Title"] = "Không có quyền truy cập";
    Context.Response.StatusCode = 403;
}

<div class="error-page">
    <div class="error-page__code font-mono">403</div>
    <h1 class="error-page__title">Không có quyền truy cập</h1>
    <p class="error-page__desc">
        Tài khoản của bạn không có quyền xem trang này.
        Vui lòng đăng nhập bằng tài khoản có phân quyền phù hợp.
    </p>
    <div class="btn-list" style="justify-content:center">
        <a asp-controller="Home" asp-action="Index" class="btn btn-outline-secondary">Về trang chủ</a>
        <a asp-controller="TaiKhoan" asp-action="DangNhap" class="btn btn-primary">Đăng nhập lại</a>
    </div>
</div>
