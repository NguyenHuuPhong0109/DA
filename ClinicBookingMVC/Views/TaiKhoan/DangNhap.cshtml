@model ClinicBookingMVC.Models.ViewModels.DangNhapVM
@{
    ViewData["Title"] = "Đăng nhập";
}

<div class="auth-wrap">
    <div class="auth-card">
        <div class="auth-card__header">
            <div class="auth-brand">
                <span class="auth-brand__cross">+</span>
                <span class="auth-brand__name">ClinicBook</span>
            </div>
            <h1 class="auth-card__title">Đăng nhập</h1>
            <p class="auth-card__sub">Hệ thống đặt lịch khám trực tuyến</p>
        </div>

        @if (TempData["Error"] != null)
        {
            <div class="alert alert--error" role="alert" style="margin-bottom:var(--space-md)">@TempData["Error"]</div>
        }

        <form method="post" asp-action="DangNhap" novalidate id="loginForm">
            @Html.AntiForgeryToken()
            <input type="hidden" name="ReturnUrl" value="@Context.Request.Query["ReturnUrl"]" />

            <div class="form-group">
                <label asp-for="TenTaiKhoan" class="form-label"></label>
                <input asp-for="TenTaiKhoan" class="form-control" autocomplete="username"
                       placeholder="Tên tài khoản" />
                <span asp-validation-for="TenTaiKhoan" class="field-validation-error"></span>
            </div>

            <div class="form-group">
                <label asp-for="MatKhau" class="form-label"></label>
                <input asp-for="MatKhau" class="form-control" autocomplete="current-password"
                       placeholder="Mật khẩu" />
                <span asp-validation-for="MatKhau" class="field-validation-error"></span>
            </div>

            <div class="form-group" style="margin-bottom:var(--space-lg)">
                <label style="display:inline-flex;align-items:center;gap:8px;cursor:pointer;font-size:var(--text-sm)">
                    <input asp-for="GhiNho" type="checkbox" style="width:16px;height:16px;accent-color:var(--color-primary)" />
                    <span>Ghi nhớ đăng nhập</span>
                </label>
            </div>

            <button type="submit" class="btn btn-primary" style="width:100%;min-height:42px;font-weight:600">Đăng nhập</button>
        </form>

        <!-- Khối hỗ trợ chuyển nhanh tài khoản kiểm thử trên điện thoại & desktop -->
        <div class="quick-login-card" style="margin-top:var(--space-lg);padding:14px;background:#F8FAFC;border:1px solid var(--color-rule);border-radius:var(--radius-card);text-align:left">
            <div style="display:flex;align-items:center;gap:6px;margin-bottom:8px">
                <span style="color:var(--color-primary);font-size:15px">⚡</span>
                <strong style="font-size:var(--text-xs);text-transform:uppercase;letter-spacing:.04em;color:var(--color-ink)">Tài khoản kiểm thử nhanh</strong>
            </div>
            <p style="font-size:var(--text-xs);color:var(--color-muted);margin-bottom:10px">
                Chạm vào vai trò để điền tự động (mật khẩu chung: <code>123456</code>):
            </p>
            <div style="display:grid;grid-template-columns:repeat(2, 1fr);gap:8px">
                <button type="button" class="btn btn-sm btn-outline-secondary" style="min-height:38px;font-size:var(--text-xs)" onclick="fillLogin('admin', '123456')">
                    👑 Quản trị (Admin)
                </button>
                <button type="button" class="btn btn-sm btn-outline-secondary" style="min-height:38px;font-size:var(--text-xs)" onclick="fillLogin('letan01', '123456')">
                    📋 Lễ tân (letan01)
                </button>
                <button type="button" class="btn btn-sm btn-outline-secondary" style="min-height:38px;font-size:var(--text-xs)" onclick="fillLogin('bacsi01', '123456')">
                    👨‍⚕️ Bác sĩ (bacsi01)
                </button>
                <button type="button" class="btn btn-sm btn-outline-secondary" style="min-height:38px;font-size:var(--text-xs)" onclick="fillLogin('benhnhan01', '123456')">
                    👤 Bệnh nhân (benhnhan01)
                </button>
            </div>
        </div>

        <div class="auth-card__footer">
            Chưa có tài khoản?
            <a asp-action="DangKy">Đăng ký ngay</a>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        function fillLogin(username, password) {
            const u = document.querySelector('input[name="TenTaiKhoan"]');
            const p = document.querySelector('input[name="MatKhau"]');
            if (u) u.value = username;
            if (p) p.value = password;
            const btn = document.querySelector('button[type="submit"]');
            if (btn) btn.focus();
        }
    </script>
}
