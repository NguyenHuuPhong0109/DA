@model ClinicBookingMVC.Models.ViewModels.DangNhapVM
@{
    ViewData["Title"] = "Đăng nhập";
}

<div class="auth-wrap">
    <div class="auth-card">
        <div class="auth-card__header">
            <div class="auth-brand">
                <span class="auth-brand__cross">+</span>
                <span class="auth-brand__name">ClinicBook</span>
            </div>
            <h1 class="auth-card__title">Đăng nhập</h1>
            <p class="auth-card__sub">Hệ thống đặt lịch khám trực tuyến</p>
        </div>

        @if (TempData["Error"] != null)
        {
            <div class="alert alert--error" role="alert" style="margin-bottom:var(--space-md)">@TempData["Error"]</div>
        }

        <form method="post" asp-action="DangNhap" novalidate>
            @Html.AntiForgeryToken()
            <input type="hidden" name="ReturnUrl" value="@Context.Request.Query["ReturnUrl"]" />

            <div class="form-group">
                <label asp-for="TenTaiKhoan" class="form-label"></label>
                <input asp-for="TenTaiKhoan" class="form-control" autocomplete="username"
                       placeholder="Tên tài khoản" />
                <span asp-validation-for="TenTaiKhoan" class="field-validation-error"></span>
            </div>

            <div class="form-group">
                <label asp-for="MatKhau" class="form-label"></label>
                <input asp-for="MatKhau" class="form-control" autocomplete="current-password"
                       placeholder="Mật khẩu" />
                <span asp-validation-for="MatKhau" class="field-validation-error"></span>
            </div>

            <div class="form-group" style="margin-bottom:var(--space-lg)">
                <label style="display:inline-flex;align-items:center;gap:8px;cursor:pointer;font-size:var(--text-sm)">
                    <input asp-for="GhiNho" type="checkbox" style="width:16px;height:16px;accent-color:var(--color-primary)" />
                    <span>Ghi nhớ đăng nhập</span>
                </label>
            </div>

            <button type="submit" class="btn btn-primary" style="width:100%">Đăng nhập</button>
        </form>

        <div class="auth-card__footer">
            Chưa có tài khoản?
            <a asp-action="DangKy">Đăng ký ngay</a>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
