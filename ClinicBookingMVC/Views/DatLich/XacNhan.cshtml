@model ClinicBookingMVC.Models.ViewModels.XacNhanDatLichVM
@{
    ViewData["Title"] = "Xác nhận đặt lịch";
}

<div class="container section-pad">

    <div class="confirm-layout">
        {{!-- Bên trái: tóm tắt lịch hẹn --}}
        <div class="confirm-summary">
            <div class="confirm-card">
                <div class="confirm-card__label">Chi tiết lịch khám</div>

                <div class="confirm-row">
                    <span class="confirm-row__key">Bác sĩ</span>
                    <span class="confirm-row__val">@Model.TenBacSi</span>
                </div>
                <div class="confirm-row">
                    <span class="confirm-row__key">Chuyên khoa</span>
                    <span class="confirm-row__val">@Model.TenChuyenKhoa</span>
                </div>
                <div class="confirm-row">
                    <span class="confirm-row__key">Phòng</span>
                    <span class="confirm-row__val">@Model.TenPhong</span>
                </div>
                <div class="confirm-row">
                    <span class="confirm-row__key">Ngày khám</span>
                    <span class="confirm-row__val font-mono">@Model.NgayKham.ToString("dd/MM/yyyy")</span>
                </div>
                <div class="confirm-row">
                    <span class="confirm-row__key">Giờ khám</span>
                    <span class="confirm-row__val font-mono">
                        @Model.GioBatDau.ToString("HH:mm") – @Model.GioKetThuc.ToString("HH:mm")
                    </span>
                </div>
            </div>

            <div class="confirm-notice">
                Vui lòng đến trước giờ hẹn <strong>15 phút</strong> để làm thủ tục check-in tại quầy lễ tân.
            </div>
        </div>

        {{!-- Bên phải: form thông tin bệnh nhân --}}
        <div class="confirm-form-wrap">
            <h1 class="page-title" style="margin-bottom:var(--space-lg)">Thông tin bệnh nhân</h1>

            @if (!ViewData.ModelState.IsValid && ViewData.ModelState.ErrorCount > 0)
            {
                <div class="alert alert--error">
                    @foreach (var err in ViewData.ModelState.Values.SelectMany(v => v.Errors))
                    {
                        <div>@err.ErrorMessage</div>
                    }
                </div>
            }

            <form method="post" asp-action="XacNhan" novalidate>
                @Html.AntiForgeryToken()
                <input type="hidden" asp-for="MaKhungGio" />
                <input type="hidden" asp-for="PhienBanDongBase64" />
                <input type="hidden" asp-for="NgayKham" />
                <input type="hidden" asp-for="GioBatDau" />
                <input type="hidden" asp-for="GioKetThuc" />

                <div class="form-group">
                    <label asp-for="SoDienThoai" class="form-label"></label>
                    <div class="input-with-status">
                        <input asp-for="SoDienThoai"
                               class="form-control font-mono"
                               placeholder="0901234567"
                               oninput="traCuuBenhNhan(this.value)" />
                        <span id="sdt-status" class="input-status"></span>
                    </div>
                    <span asp-validation-for="SoDienThoai" class="form-error"></span>
                </div>

                <div class="form-group">
                    <label asp-for="TenBenhNhan" class="form-label"></label>
                    <input asp-for="TenBenhNhan" id="tenBenhNhan"
                           class="form-control" placeholder="Nguyễn Văn A" />
                    <span asp-validation-for="TenBenhNhan" class="form-error"></span>
                </div>

                <div class="form-row-2">
                    <div class="form-group">
                        <label asp-for="NamSinh" class="form-label"></label>
                        <input asp-for="NamSinh" id="namSinh" type="number"
                               class="form-control font-mono" placeholder="1990" min="1920" max="2024" />
                        <span asp-validation-for="NamSinh" class="form-error"></span>
                    </div>
                    <div class="form-group">
                        <label asp-for="GioiTinh" class="form-label"></label>
                        <select asp-for="GioiTinh" id="gioiTinh" class="form-control">
                            <option value="">— Chọn —</option>
                            <option value="Nam">Nam</option>
                            <option value="Nu">Nữ</option>
                            <option value="Khac">Khác</option>
                        </select>
                    </div>
                </div>

                <div class="form-group">
                    <label asp-for="Email" class="form-label"></label>
                    <input asp-for="Email" id="email" class="form-control"
                           placeholder="email@example.com (không bắt buộc)" />
                    <span asp-validation-for="Email" class="form-error"></span>
                </div>

                <div class="form-group">
                    <label asp-for="LyDoKham" class="form-label"></label>
                    <textarea asp-for="LyDoKham" class="form-control" rows="2"
                              placeholder="Triệu chứng hoặc lý do khám (không bắt buộc)"></textarea>
                </div>

                <div class="form-group">
                    <label class="form-check">
                        <input asp-for="GuiNhacLich" type="checkbox" />
                        <span>Nhận nhắc lịch trước giờ hẹn</span>
                    </label>
                </div>

                <div class="form-actions">
                    <button type="submit" class="btn btn--primary btn--lg">
                        Xác nhận đặt lịch
                    </button>
                    <a asp-action="Index" class="btn btn--ghost">Chọn lại</a>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
<partial name="_ValidationScriptsPartial" />
<script>
let _traCuuTimeout;
async function traCuuBenhNhan(sdt) {
    clearTimeout(_traCuuTimeout);
    const statusEl = document.getElementById('sdt-status');
    if (sdt.length < 9) { statusEl.textContent = ''; return; }

    _traCuuTimeout = setTimeout(async () => {
        statusEl.textContent = '...';
        try {
            const res = await fetch(`/DatLich/TraCuuBenhNhan?sdt=${encodeURIComponent(sdt)}`);
            const data = await res.json();
            if (data) {
                document.getElementById('tenBenhNhan').value = data.tenBenhNhan ?? '';
                statusEl.textContent = '✓ Khách quen';
                statusEl.className = 'input-status input-status--ok';
            } else {
                statusEl.textContent = 'Bệnh nhân mới';
                statusEl.className = 'input-status input-status--new';
            }
        } catch { statusEl.textContent = ''; }
    }, 500);
}
</script>
}
