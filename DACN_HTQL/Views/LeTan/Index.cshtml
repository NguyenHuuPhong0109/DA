@model DACN_HTQL.Models.ViewModels.LeTanIndexVM
@{
    Layout = "_PortalLayout";
    ViewData["Title"]      = "Quầy lễ tân";
    ViewData["ActiveMenu"] = "LeTan";
    var thongKePhong   = ViewBag.ThongKePhong   as List<DACN_HTQL.Services.PhongChoVM> ?? new();
    var dsChuyenKhoa   = ViewBag.DanhSachChuyenKhoa as List<DACN_HTQL.Models.Entities.ChuyenKhoa> ?? new();
    int maPhong        = Model.MaPhongDangChon ?? 0;
}

@* ── Thanh lọc: Chọn phòng + chuyên khoa ── *@
<div class="page-toolbar">
    <div style="display:flex;justify-content:space-between;align-items:center;flex-wrap:wrap;gap:var(--space-md);width:100%">
        <form method="get" action="/LeTan" class="toolbar-form" style="margin:0">
            <div class="form-row-inline">
                <select name="maPhong" class="form-control form-control--sm"
                        onchange="this.form.submit()" aria-label="Chọn phòng khám" style="min-width:200px">
                    <option value="">— Chọn phòng khám —</option>
                    @foreach (var p in thongKePhong)
                    {
                        if (p.MaPhong == maPhong)
                        {
                            <option value="@p.MaPhong" selected>
                                @p.TenPhong — @p.SoDangCho chờ
                            </option>
                        }
                        else
                        {
                            <option value="@p.MaPhong">
                                @p.TenPhong — @p.SoDangCho chờ
                            </option>
                        }
                    }
                </select>
                <span class="font-mono text-muted text-sm">
                    📅 @Model.NgayHienTai.ToString("dd/MM/yyyy")
                </span>
            </div>
        </form>

        @* Khung check-in nhanh theo MaDatHen / SoDienThoai + Nút quét quá hạn *@
        <div class="btn-list">
            <div class="checkin-nhanh-bar">
                <input type="text" id="inp-checkin-nhanh" class="form-control form-control--sm font-mono"
                       placeholder="Nhập mã BKxxxxxx hoặc SĐT..." autocomplete="off"
                       style="width:240px" oninput="traTimPhieuNhanh(this.value)" />
                <div id="kq-checkin-nhanh" class="checkin-nhanh-popup" style="display:none"></div>
            </div>

            <form method="post" asp-action="QuetQuaHanNgay" style="margin:0">
                @Html.AntiForgeryToken()
                <input type="hidden" name="maPhong" value="@Model.MaPhongDangChon" />
                <button type="submit" class="btn btn-sm btn-outline-secondary" title="Quét vắng hẹn quá 30 phút và gửi nhắc lịch">
                    ⏱️ Quét quá hạn ngay
                </button>
            </form>
        </div>
    </div>
</div>

@if (!Model.MaPhongDangChon.HasValue)
{
    @* Hiển thị lưới phòng + tổng quan khi chưa chọn phòng *@
    <section style="margin-top:var(--space-lg)">
        <h2 class="section-heading">Tổng quan hàng đợi phòng khám</h2>
        @if (!thongKePhong.Any())
        {
            <p class="empty-notice" style="color:var(--color-muted);padding:var(--space-xl) 0;text-align:center">
                Chưa có phòng khám nào đang hoạt động hôm nay.
            </p>
        }
        else
        {
            <div class="phong-grid">
                @foreach (var p in thongKePhong)
                {
                    <a href="/LeTan?maPhong=@p.MaPhong" class="phong-card @(p.SoDangCho > 5 ? "phong-card--busy" : "")">
                        <div class="phong-card__ten">@p.TenPhong</div>
                        <div class="phong-card__ck">@p.TenChuyenKhoa</div>
                        <div class="phong-card__stats">
                            <span class="phong-card__num font-mono">@p.SoDangCho</span>
                            <span class="phong-card__label">đang chờ</span>
                        </div>
                        @if (p.SoDangGoi > 0)
                        {
                            <div class="badge badge--da-xac-nhan" style="margin-top:var(--space-xs)">Đang gọi: @p.SoDangGoi</div>
                        }
                    </a>
                }
            </div>
        }
    </section>
}
else
{
    @* ── Thống kê 4 ô ── *@
    <div class="stats-grid" style="margin-bottom:var(--space-lg)">
        <div class="stat-card">
            <div class="stat-card__value font-mono">@Model.SoDangCho</div>
            <div class="stat-card__label">Đang chờ</div>
        </div>
        <div class="stat-card">
            <div class="stat-card__value font-mono" style="color:var(--color-info)">@Model.SoDangGoi</div>
            <div class="stat-card__label">Đang gọi</div>
        </div>
        <div class="stat-card">
            <div class="stat-card__value font-mono" style="color:var(--color-success)">@Model.SoDangKham</div>
            <div class="stat-card__label">Đang khám</div>
        </div>
        <div class="stat-card">
            <div class="stat-card__value font-mono" style="color:var(--color-muted)">@Model.SoHoanTat</div>
            <div class="stat-card__label">Hoàn tất</div>
        </div>
    </div>

    <div class="portal-two-col">

        @* ── CỘT TRÁI: Hàng đợi ── *@
        <section>
            <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:var(--space-md)">
                <h2 class="section-heading" style="margin-bottom:0">Hàng đợi thực tế</h2>
                <span class="text-xs text-muted">Tự động cập nhật mỗi 30 giây</span>
            </div>

            @if (!Model.HangDoi.Any())
            {
                <div class="card" style="text-align:center;padding:var(--space-2xl);color:var(--color-muted)">
                    Chưa có bệnh nhân check-in hôm nay tại phòng khám này.
                </div>
            }
            else
            {
                <div class="table-wrap">
                    <table class="table" id="tbl-hangdoi">
                        <thead>
                            <tr>
                                <th>Số</th>
                                <th>Họ tên</th>
                                <th>Loại</th>
                                <th>Giờ hẹn</th>
                                <th>Trạng thái</th>
                                <th style="text-align:right">Thao tác</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var h in Model.HangDoi)
                            {
                                var prefix = DACN_HTQL.Services.HangDoiService.LoaiKhachToPrefix(h.LoaiKhach);
                                var soHien = $"{prefix}-{h.SoThuTu:D3}";
                                var badgeCls = h.TrangThaiPhieu switch {
                                    "DangCho"  => "badge--dang-cho",
                                    "DangGoi"  => "badge--dang-goi",
                                    "DangKham" => "badge--dang-kham",
                                    "QuaLuot"  => "badge--qua-luot",
                                    "HoanTat"  => "badge--hoan-tat",
                                    _ => ""
                                };
                                var tenTT = h.TrangThaiPhieu switch {
                                    "DangCho"  => "Đang chờ",
                                    "DangGoi"  => "Đang gọi",
                                    "DangKham" => "Đang khám",
                                    "QuaLuot"  => "Quá lượt",
                                    "HoanTat"  => "Hoàn tất",
                                    _ => h.TrangThaiPhieu
                                };
                                var loaiLabel = h.LoaiKhach switch {
                                    "DatTruoc"    => "Đặt trước",
                                    "DatTruocTre" => "Đặt trước (trễ)",
                                    "VangLai"     => "Vãng lai",
                                    "ThongThuong" => "Đặt trước",
                                    _ => h.LoaiKhach
                                };
                                var coCanhBao = h.BenhNhan?.CoCanhBao == true;

                                <tr class="@(coCanhBao ? "row--canh-bao" : "")">
                                    <td>
                                        <span class="font-mono queue-num--sm @(prefix == "W" ? "color-walkin" : prefix == "L" ? "color-late" : "color-hen")">
                                            @soHien
                                        </span>
                                    </td>
                                    <td>
                                        <strong>@h.BenhNhan?.TenBenhNhan</strong>
                                        @if (coCanhBao)
                                        {
                                            <span class="badge badge--canh-bao" title="Vắng hẹn @h.BenhNhan?.SoLanVangHen lần" style="margin-left:4px">
                                                &#9888; Cảnh báo
                                            </span>
                                        }
                                    </td>
                                    <td class="text-xs text-muted">@loaiLabel</td>
                                    <td class="font-mono">
                                        @(h.GioHen.HasValue ? h.GioHen.Value.ToString(@"HH\:mm") : "—")
                                    </td>
                                    <td><span class="badge @badgeCls">@tenTT</span></td>
                                    <td style="text-align:right">
                                        <div class="btn-list btn-list-end">
                                            @if (h.TrangThaiPhieu == "DangCho")
                                            {
                                                <form method="post" action="/LeTan/BatDauKham" style="margin:0">
                                                    @Html.AntiForgeryToken()
                                                    <input type="hidden" name="maPhieu" value="@h.MaPhieu" />
                                                    <input type="hidden" name="maPhong" value="@maPhong" />
                                                    <button type="submit" class="btn btn-sm btn-success">Vào khám</button>
                                                </form>
                                            }
                                            @if (h.TrangThaiPhieu == "DangKham")
                                            {
                                                <form method="post" action="/LeTan/HoanTat" style="margin:0">
                                                    @Html.AntiForgeryToken()
                                                    <input type="hidden" name="maPhieu" value="@h.MaPhieu" />
                                                    <input type="hidden" name="maPhong" value="@maPhong" />
                                                    <button type="submit" class="btn btn-sm btn-outline-secondary">Hoàn tất</button>
                                                </form>
                                            }
                                            @if (h.TrangThaiPhieu == "QuaLuot")
                                            {
                                                <form method="post" action="/LeTan/KhoiPhuc" style="margin:0">
                                                    @Html.AntiForgeryToken()
                                                    <input type="hidden" name="maPhieu" value="@h.MaPhieu" />
                                                    <input type="hidden" name="maPhong" value="@maPhong" />
                                                    <button type="submit" class="btn btn-sm btn-warning"
                                                            title="Đưa bệnh nhân về cuối hàng chờ">
                                                        ↩ Khôi phục
                                                    </button>
                                                </form>
                                            }
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </section>

        @* ── CỘT PHẢI: Sidebar ── *@
        <aside>

            @* Check-in vãng lai + auto-fill *@
            <div class="side-card" style="margin-bottom:var(--space-lg)">
                <h3 class="side-card__title">Tiếp nhận vãng lai / Đặt hộ</h3>
                <div class="form-group">
                    <label class="form-label">Số điện thoại</label>
                    <div class="input-with-status">
                        <input type="tel" id="sdt-vanglai" class="form-control font-mono"
                               placeholder="09x xxx xxxx" autocomplete="off"
                               oninput="traTimBenhNhan(this.value)" />
                        <span id="sdt-status" class="input-status"></span>
                    </div>
                </div>
                <div id="info-benhnhan" style="display:none" class="benhnhan-preview"></div>

                <form method="post" action="/LeTan/CheckInVangLai" id="form-vanglai">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="maPhong" value="@maPhong" />
                    <input type="hidden" id="sdt-hidden" name="soDienThoai" />
                    <button type="submit" class="btn btn-primary" style="width:100%;margin-top:var(--space-sm)"
                            onclick="document.getElementById('sdt-hidden').value = document.getElementById('sdt-vanglai').value">
                        Check-in Walk-in
                    </button>
                </form>
            </div>

            @* Phiếu hẹn chờ xác nhận *@
            @if (Model.ChoXacNhan.Any())
            {
                <div class="side-card">
                    <h3 class="side-card__title">
                        Chờ xác nhận
                        <span class="badge badge--vang-hen" style="margin-left:4px">@Model.SoChoXacNhan</span>
                    </h3>
                    <div class="phieu-list">
                        @foreach (var p in Model.ChoXacNhan)
                        {
                            <div class="phieu-item @(p.BenhNhan?.CoCanhBao == true ? "phieu-item--canh-bao" : "")">
                                <div class="phieu-item__head">
                                    <span class="font-mono" style="font-size:var(--text-sm);font-weight:700;color:var(--color-primary)">
                                        @p.MaDatHen
                                    </span>
                                    @if (p.BenhNhan?.CoCanhBao == true)
                                    {
                                        <span class="badge badge--canh-bao"
                                              title="Đã vắng hẹn @p.BenhNhan?.SoLanVangHen lần">
                                            &#9888; Cảnh báo
                                        </span>
                                    }
                                </div>
                                <div class="phieu-item__name">@p.BenhNhan?.TenBenhNhan</div>
                                <div class="phieu-item__time font-mono">
                                    @p.KhungGio?.GioBatDau.ToString(@"HH\:mm")
                                    — @p.KhungGio?.CaTruc?.BacSi?.HoTenBacSi
                                </div>
                                <div class="btn-list" style="margin-top:var(--space-xs)">
                                    <form method="post" action="/LeTan/XacNhanPhieu" style="display:inline;margin:0">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="maPhieuHen" value="@p.MaPhieuHen" />
                                        <input type="hidden" name="maPhong"    value="@maPhong" />
                                        <button type="submit" class="btn btn-sm btn-success">Xác nhận</button>
                                    </form>
                                    <form method="post" action="/LeTan/CheckIn" style="display:inline;margin:0">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="maPhieuHen" value="@p.MaPhieuHen" />
                                        <input type="hidden" name="maPhong"    value="@maPhong" />
                                        <button type="submit" class="btn btn-sm btn-primary">Check-in</button>
                                    </form>
                                </div>
                            </div>
                        }
                    </div>
                </div>
            }
        </aside>
    </div>

    @* Auto-refresh 30s *@
    <script>
        let _rfTimeout = setTimeout(() => window.location.reload(), 30000);

        // ── Tra cứu nhanh theo MaDatHen / SĐT ──────────────────────────────
        let _rfTimer;
        function traTimPhieuNhanh(val) {
            clearTimeout(_rfTimer);
            if (val.length < 3) { document.getElementById('kq-checkin-nhanh').style.display = 'none'; return; }
            _rfTimer = setTimeout(async () => {
                const res = await fetch(`/LeTan/TraCuuNhanh?q=${encodeURIComponent(val)}`);
                const d   = await res.json();
                const box = document.getElementById('kq-checkin-nhanh');
                if (!d) { box.style.display = 'none'; return; }

                const canh = d.coCanhBao
                    ? `<span class="badge badge--canh-bao" title="Đã vắng hẹn ${d.soLanVangHen} lần">&#9888; Cảnh báo</span>`
                    : '';

                box.innerHTML = `
                    <div class="checkin-popup__head">
                        <strong>${d.tenBenhNhan}</strong> ${canh}
                        <span class="font-mono text-muted text-xs">${d.maDatHen}</span>
                    </div>
                    <div style="font-size:var(--text-xs);color:var(--color-muted);margin:4px 0">
                        ${d.gioHen} · ${d.tenBacSi} · ${d.tenPhong}
                    </div>
                    <div class="checkin-popup__status">Trạng thái: <strong>${d.trangThaiHen}</strong></div>
                    ${d.trangThaiHen !== 'DaCheckIn' && d.trangThaiHen !== 'DaKham' ? `
                    <form method="post" action="/LeTan/CheckIn" style="margin-top:8px">
                        <input type="hidden" name="__RequestVerificationToken" value="${document.querySelector('input[name=__RequestVerificationToken]').value}" />
                        <input type="hidden" name="maPhieuHen" value="${d.maPhieuHen}" />
                        <input type="hidden" name="maPhong"    value="${d.maPhong}" />
                        <button type="submit" class="btn btn-sm btn-primary">Check-in ngay</button>
                    </form>` : ''}
                `;
                box.style.display = '';
                // Reset auto-refresh khi đang thao tác
                clearTimeout(_rfTimeout);
            }, 350);
        }

        // ── Auto-fill bệnh nhân vãng lai ─────────────────────────────────────
        let _bTimer;
        async function traTimBenhNhan(sdt) {
            clearTimeout(_bTimer);
            const statusEl = document.getElementById('sdt-status');
            const infoEl   = document.getElementById('info-benhnhan');

            if (sdt.length < 9) { statusEl.textContent = ''; infoEl.style.display = 'none'; return; }

            _bTimer = setTimeout(async () => {
                const res = await fetch(`/LeTan/TraCuuBenhNhan?sdt=${encodeURIComponent(sdt)}`);
                const d   = await res.json();

                if (d) {
                    statusEl.textContent = '✓ Khách quen';
                    statusEl.className   = 'input-status input-status--ok';
                    const soLanVang = d.soLanVangHen > 0
                        ? `<span class="badge badge--canh-bao" style="margin-left:4px">&#9888; Vắng ${d.soLanVangHen} lần</span>`
                        : '';
                    infoEl.innerHTML = `
                        <strong>${d.tenBenhNhan}</strong>${soLanVang}
                        <div style="font-size:var(--text-xs);color:var(--color-muted)">
                            ${d.namSinh ? `${new Date().getFullYear() - d.namSinh} tuổi` : ''}
                            ${d.gioiTinh ? '· ' + d.gioiTinh : ''}
                        </div>`;
                    infoEl.style.display = '';
                } else {
                    statusEl.textContent = '+ Khách mới';
                    statusEl.className   = 'input-status input-status--new';
                    infoEl.style.display = 'none';
                }
            }, 400);
        }

        // Đóng popup khi click ngoài
        document.addEventListener('click', (e) => {
            if (!e.target.closest('.checkin-nhanh-bar')) {
                document.getElementById('kq-checkin-nhanh').style.display = 'none';
            }
        });
    </script>
}
