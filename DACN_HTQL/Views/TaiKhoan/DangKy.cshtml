@model DACN_HTQL.Models.ViewModels.DangKyVM
@{
    ViewData["Title"] = "Đăng ký tài khoản";
}

<div class="auth-wrap">
    <div class="auth-card auth-card--wide">
        <div class="auth-card__header">
            <div class="auth-brand">
                <span class="auth-brand__cross">+</span>
                <span class="auth-brand__name">ClinicBook</span>
            </div>
            <h1 class="auth-card__title">Tạo tài khoản</h1>
            <p class="auth-card__sub">Đăng ký để đặt lịch khám trực tuyến nhanh chóng</p>
        </div>

        @if (TempData["Error"] != null)
        {
            <div class="alert alert--error" style="margin-bottom:var(--space-md)">@TempData["Error"]</div>
        }

        <form method="post" asp-action="DangKy" novalidate>
            @Html.AntiForgeryToken()

            <div style="display:grid;grid-template-columns:1fr 1fr;gap:var(--space-md)">
                <div class="form-group">
                    <label asp-for="HoTen" class="form-label"></label>
                    <input asp-for="HoTen" class="form-control" placeholder="Nguyễn Văn A" />
                    <span asp-validation-for="HoTen" class="field-validation-error"></span>
                </div>
                <div class="form-group">
                    <label asp-for="SoDienThoai" class="form-label"></label>
                    <input asp-for="SoDienThoai" class="form-control font-mono" placeholder="0901234567" />
                    <span asp-validation-for="SoDienThoai" class="field-validation-error"></span>
                </div>
            </div>

            <div class="form-group">
                <label asp-for="Email" class="form-label"></label>
                <input asp-for="Email" class="form-control" placeholder="email@example.com (không bắt buộc)" />
                <span asp-validation-for="Email" class="field-validation-error"></span>
            </div>

            <div class="form-group">
                <label asp-for="TenTaiKhoan" class="form-label"></label>
                <input asp-for="TenTaiKhoan" class="form-control" placeholder="Ít nhất 4 ký tự"
                       autocomplete="username" />
                <span asp-validation-for="TenTaiKhoan" class="field-validation-error"></span>
            </div>

            <div style="display:grid;grid-template-columns:1fr 1fr;gap:var(--space-md)">
                <div class="form-group">
                    <label asp-for="MatKhau" class="form-label"></label>
                    <input asp-for="MatKhau" class="form-control" placeholder="Ít nhất 6 ký tự"
                           autocomplete="new-password" />
                    <span asp-validation-for="MatKhau" class="field-validation-error"></span>
                </div>
                <div class="form-group">
                    <label asp-for="XacNhanMatKhau" class="form-label"></label>
                    <input asp-for="XacNhanMatKhau" class="form-control" placeholder="Nhập lại mật khẩu"
                           autocomplete="new-password" />
                    <span asp-validation-for="XacNhanMatKhau" class="field-validation-error"></span>
                </div>
            </div>

            <button type="submit" class="btn btn-primary" style="width:100%;margin-top:var(--space-md)">Tạo tài khoản</button>
        </form>

        <div class="auth-card__footer">
            Đã có tài khoản?
            <a asp-action="DangNhap">Đăng nhập</a>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
