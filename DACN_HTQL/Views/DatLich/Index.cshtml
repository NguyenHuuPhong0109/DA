@model IEnumerable<DACN_HTQL.Models.Entities.ChuyenKhoa>
@{
    ViewData["Title"] = "Đặt lịch khám";
}

<div class="booking-page">

    @* Thanh tiến trình 4 bước *@
    <div class="container">
        <div class="booking-steps">
            <div class="booking-step active" data-step="1">
                <span class="booking-step__num font-mono">01</span>
                <span class="booking-step__label">Chuyên khoa</span>
            </div>
            <div class="booking-step" data-step="2">
                <span class="booking-step__num font-mono">02</span>
                <span class="booking-step__label">Bác sĩ &amp; Ngày</span>
            </div>
            <div class="booking-step" data-step="3">
                <span class="booking-step__num font-mono">03</span>
                <span class="booking-step__label">Khung giờ</span>
            </div>
            <div class="booking-step" data-step="4">
                <span class="booking-step__num font-mono">04</span>
                <span class="booking-step__label">Xác nhận</span>
            </div>
        </div>
    </div>

    @* Step 1: Chọn chuyên khoa *@
    <section class="booking-panel" id="step-1">
        <div class="container">
            <h2 class="booking-panel__title">Chọn chuyên khoa</h2>
            <div class="specialty-grid">
                @foreach (var ck in Model)
                {
                    <button type="button"
                            class="specialty-card"
                            data-id="@ck.MaChuyenKhoa"
                            data-ten="@ck.TenChuyenKhoa"
                            onclick="chonChuyenKhoa(@ck.MaChuyenKhoa, '@Html.Raw(ck.TenChuyenKhoa)')">
                        <div class="specialty-card__icon-wrap">
                            <img src="@SpecialtyIconHelper.GetIconPath(ck.TenChuyenKhoa)"
                                 alt="@ck.TenChuyenKhoa"
                                 width="52"
                                 height="52"
                                 class="specialty-card__icon"
                                 loading="lazy" />
                        </div>
                        <span class="specialty-card__name">@ck.TenChuyenKhoa</span>
                    </button>
                }
            </div>
        </div>
    </section>

    @* Step 2: Chọn bác sĩ + ngày *@
    <section class="booking-panel" id="step-2" style="display:none">
        <div class="container">
            <div class="booking-panel__head">
                <button type="button" class="btn btn-sm btn-outline-secondary" onclick="quayLai(1)">Quay lại</button>
                <h2 class="booking-panel__title" style="margin-bottom:0">
                    Bác sĩ — <span id="tenChuyenKhoa" class="text-accent"></span>
                </h2>
            </div>

            <div class="form-group" style="max-width:280px">
                <label class="form-label">Chọn ngày khám</label>
                <input type="date" id="ngayKham" class="form-control font-mono"
                       min="@DateTime.Today.ToString("yyyy-MM-dd")"
                       value="@DateTime.Today.AddDays(1).ToString("yyyy-MM-dd")"
                       onchange="layDanhSachBacSi()" />
            </div>

            <div id="loading-bacsi" style="display:none;color:var(--color-muted);padding:var(--space-md) 0">Đang tải danh sách bác sĩ...</div>
            <div id="ds-bacsi" class="doctor-grid"></div>
            <div id="no-bacsi" style="display:none;color:var(--color-muted);padding:var(--space-md) 0">
                Không có bác sĩ nào có lịch trống trong ngày này. Vui lòng chọn ngày khác.
            </div>
        </div>
    </section>

    @* Step 3: Lưới khung giờ *@
    <section class="booking-panel" id="step-3" style="display:none">
        <div class="container">
            <div class="booking-panel__head">
                <button type="button" class="btn btn-sm btn-outline-secondary" onclick="quayLai(2)">Quay lại</button>
                <div>
                    <h2 class="booking-panel__title" id="tenBacSiSlot" style="margin-bottom:0"></h2>
                    <p class="booking-panel__sub" id="infoSlot"></p>
                </div>
            </div>

            <div id="loading-slot" style="display:none;color:var(--color-muted);padding:var(--space-md) 0">Đang tải khung giờ...</div>
            <div id="luoi-khung-gio" class="slots-grid"></div>
        </div>
    </section>

</div>

@section Scripts {
<script>
let _chuyenKhoa = { id: 0, ten: '' };
let _bacSi = { id: 0, ten: '' };
let _khungGio = { id: 0, phienBan: '' };

function resetSpecialtyCards() {
    _chuyenKhoa = { id: 0, ten: '' };
    document.querySelectorAll('.specialty-card').forEach(c => {
        c.classList.remove('active', 'selected');
        c.removeAttribute('aria-pressed');
    });
    if (document.activeElement && typeof document.activeElement.blur === 'function') {
        document.activeElement.blur();
    }
}

function buocHienTai(n) {
    if (n === 1) {
        resetSpecialtyCards();
    }
    document.querySelectorAll('.booking-step').forEach((el, i) => {
        el.classList.toggle('active', i + 1 === n);
        el.classList.toggle('done', i + 1 < n);
    });
    document.querySelectorAll('.booking-panel').forEach((el, i) => {
        el.style.display = (i + 1 === n) ? '' : 'none';
    });
}

function quayLai(n) {
    if (n === 1) {
        resetSpecialtyCards();
    }
    buocHienTai(n);
}

function chonChuyenKhoa(id, ten) {
    _chuyenKhoa = { id, ten };
    document.querySelectorAll('.specialty-card').forEach(c => {
        const isMatch = c.getAttribute('data-id') == id;
        c.classList.toggle('active', isMatch);
        c.classList.toggle('selected', isMatch);
        if (isMatch) {
            c.setAttribute('aria-pressed', 'true');
        } else {
            c.removeAttribute('aria-pressed');
        }
    });
    document.getElementById('tenChuyenKhoa').textContent = ten;
    buocHienTai(2);
    layDanhSachBacSi();
}

async function layDanhSachBacSi() {
    const ngay = document.getElementById('ngayKham').value;
    if (!ngay || !_chuyenKhoa.id) return;

    document.getElementById('loading-bacsi').style.display = '';
    document.getElementById('ds-bacsi').innerHTML = '';
    document.getElementById('no-bacsi').style.display = 'none';

    const res = await fetch(`/DatLich/LayBacSi?maChuyenKhoa=${_chuyenKhoa.id}&ngay=${ngay}`);
    const data = await res.json();

    document.getElementById('loading-bacsi').style.display = 'none';

    if (!data || data.length === 0) {
        document.getElementById('no-bacsi').style.display = '';
        return;
    }

    const grid = document.getElementById('ds-bacsi');
    grid.innerHTML = data.map(bs => `
        <button type="button" class="doctor-card" onclick="chonBacSi(${bs.maBacSi}, '${bs.hoTenBacSi}', '${bs.hocVi ?? ''}')">
            <div class="doctor-card__avatar" aria-hidden="true">${bs.hoTenBacSi.split(' ').pop()[0]}</div>
            <div class="doctor-card__info">
                <div class="doctor-card__name">${bs.hocVi ? bs.hocVi + ' ' : ''}${bs.hoTenBacSi}</div>
                <div class="doctor-card__slots font-mono">${bs.soSlotTrong} khung giờ trống</div>
            </div>
        </button>
    `).join('');
}

async function chonBacSi(id, ten, hocVi) {
    _bacSi = { id, ten };
    const ngay = document.getElementById('ngayKham').value;
    document.getElementById('tenBacSiSlot').textContent = `${hocVi ? hocVi + ' ' : ''}${ten}`;
    buocHienTai(3);

    document.getElementById('loading-slot').style.display = '';
    document.getElementById('luoi-khung-gio').innerHTML = '';

    const res = await fetch(`/DatLich/LayKhungGio?maBacSi=${id}&ngay=${ngay}`);
    const data = await res.json();

    document.getElementById('loading-slot').style.display = 'none';

    if (!data) {
        document.getElementById('luoi-khung-gio').innerHTML =
            '<p class="empty-notice" style="color:var(--color-muted);padding:var(--space-md) 0">Không tìm thấy ca trực.</p>';
        return;
    }

    document.getElementById('infoSlot').textContent =
        `${data.tenPhong} · ${ngay.split('-').reverse().join('/')}`;

    const grid = document.getElementById('luoi-khung-gio');
    if (!data.slots || data.slots.length === 0) {
        grid.innerHTML = '<p class="empty-notice" style="color:var(--color-muted);padding:var(--space-md) 0">Không có khung giờ trống.</p>';
        return;
    }

    grid.innerHTML = data.slots.map(s => {
        const disabled = s.trangThai !== 'ConTrong';
        const css = disabled
            ? (s.trangThai === 'DaDat' ? 'slot--da-dat is-taken' : 'slot--tam-khoa is-locked')
            : 'slot--trong';
        const label = disabled
            ? (s.trangThai === 'DaDat' ? 'Đã đặt' : 'Tạm khóa')
            : '';
        return `
            <button type="button"
                    class="slot-btn ${css}"
                    ${disabled ? 'disabled aria-disabled="true"' : ''}
                    onclick="chonSlot(${s.maKhungGio}, '${s.phienBanDongBase64 ?? ''}')">
                <span class="slot-btn__time font-mono">
                    ${s.gioBatDau.substring(0,5)} – ${s.gioKetThuc.substring(0,5)}
                </span>
                ${label ? `<span class="slot-btn__status font-mono" style="font-size:0.6875rem;margin-top:2px">${label}</span>` : ''}
            </button>
        `;
    }).join('');
}

function chonSlot(maKhungGio, phienBan) {
    _khungGio = { id: maKhungGio, phienBan };
    window.location.href = `/DatLich/XacNhan?maKhungGio=${maKhungGio}`;
}

// Cho phép bấm trực tiếp vào bước trên thanh tiến trình để quay lại
document.querySelectorAll('.booking-step').forEach(stepEl => {
    stepEl.style.cursor = 'pointer';
    stepEl.addEventListener('click', () => {
        const stepNum = parseInt(stepEl.getAttribute('data-step') || '1', 10);
        if (stepNum === 1) {
            quayLai(1);
        } else if (stepNum === 2 && _chuyenKhoa.id) {
            buocHienTai(2);
        }
    });
});

// Xử lý khi bấm nút Back của trình duyệt (chống dính trạng thái do bfcache & :focus)
window.addEventListener('pageshow', function (event) {
    const urlParams = new URLSearchParams(window.location.search);
    const maChuyenKhoa = urlParams.get('maChuyenKhoa');
    const step1El = document.getElementById('step-1');
    const isStep1Visible = step1El && step1El.style.display !== 'none';

    if (!maChuyenKhoa || isStep1Visible || event.persisted) {
        if (!maChuyenKhoa) {
            resetSpecialtyCards();
            buocHienTai(1);
        }
    }
});

window.addEventListener('popstate', function () {
    const urlParams = new URLSearchParams(window.location.search);
    const maChuyenKhoa = urlParams.get('maChuyenKhoa');
    if (!maChuyenKhoa) {
        resetSpecialtyCards();
        buocHienTai(1);
    }
});
</script>
}
