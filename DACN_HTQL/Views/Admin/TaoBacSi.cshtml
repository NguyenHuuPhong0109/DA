@model DACN_HTQL.Models.ViewModels.TaoBacSiVM
@{
    Layout = "~/Views/Shared/_PortalLayout.cshtml";
    ViewData["Title"] = "Thêm Bác sĩ";
    ViewData["ActiveMenu"] = "BacSi";
}

<div class="portal-content__head">
    <div>
        <h1 class="portal-content__title">Thêm Bác sĩ mới</h1>
        <p class="portal-content__sub">Tạo hồ sơ bác sĩ và tài khoản đăng nhập</p>
    </div>
    <div class="btn-list">
        <a asp-action="BacSi" class="btn btn-outline-secondary">Quay lại</a>
    </div>
</div>

<div class="card" style="max-width:680px">
    <form method="post" asp-action="TaoBacSi" novalidate>
        @Html.AntiForgeryToken()

        <h3 style="font-size:var(--text-md);margin-bottom:var(--space-md);color:var(--color-primary)">Thông tin bác sĩ</h3>
        <div style="display:grid;grid-template-columns:1fr 1fr;gap:var(--space-md)">
            <div class="form-group">
                <label asp-for="HoTenBacSi" class="form-label"></label>
                <input asp-for="HoTenBacSi" class="form-control" placeholder="BS. Nguyễn Văn A" />
                <span asp-validation-for="HoTenBacSi" class="field-validation-error"></span>
            </div>
            <div class="form-group">
                <label asp-for="HocVi" class="form-label"></label>
                <input asp-for="HocVi" class="form-control" placeholder="ThS., TS., PGS.TS." />
            </div>
        </div>
        <div style="display:grid;grid-template-columns:1fr 1fr;gap:var(--space-md)">
            <div class="form-group">
                <label asp-for="SoDienThoai" class="form-label"></label>
                <input asp-for="SoDienThoai" class="form-control font-mono" placeholder="0901234567" />
                <span asp-validation-for="SoDienThoai" class="field-validation-error"></span>
            </div>
            <div class="form-group">
                <label asp-for="MaChuyenKhoa" class="form-label"></label>
                <select asp-for="MaChuyenKhoa" asp-items="ViewBag.ChuyenKhoaList" class="form-control">
                    <option value="">-- Chọn chuyên khoa --</option>
                </select>
                <span asp-validation-for="MaChuyenKhoa" class="field-validation-error"></span>
            </div>
        </div>

        <h3 style="font-size:var(--text-md);margin:var(--space-lg) 0 var(--space-md) 0;color:var(--color-primary)">Tài khoản đăng nhập</h3>
        <div class="form-group">
            <label asp-for="TenTaiKhoan" class="form-label"></label>
            <input asp-for="TenTaiKhoan" class="form-control"
                   placeholder="VD: bs.nguyenvana" autocomplete="off" />
            <span asp-validation-for="TenTaiKhoan" class="field-validation-error"></span>
        </div>
        <div class="form-group">
            <label asp-for="MatKhau" class="form-label"></label>
            <input asp-for="MatKhau" class="form-control"
                   placeholder="Ít nhất 6 ký tự" autocomplete="new-password" />
            <span asp-validation-for="MatKhau" class="field-validation-error"></span>
        </div>

        <div class="btn-list" style="margin-top:var(--space-lg)">
            <button type="submit" class="btn btn-primary">Tạo bác sĩ</button>
            <a asp-action="BacSi" class="btn btn-outline-secondary">Hủy</a>
        </div>
    </form>
</div>

@section Scripts { <partial name="_ValidationScriptsPartial" /> }
