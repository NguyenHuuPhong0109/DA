@model DACN_HTQL.Models.ViewModels.SuaBacSiVM
@{
    Layout = "~/Views/Shared/_PortalLayout.cshtml";
    ViewData["Title"] = "Sửa Bác sĩ";
    ViewData["ActiveMenu"] = "BacSi";
}

<div class="portal-content__head">
    <div>
        <h1 class="portal-content__title">Sửa thông tin Bác sĩ</h1>
        <p class="portal-content__sub">Cập nhật hồ sơ bác sĩ #@Model.MaBacSi</p>
    </div>
    <div class="btn-list">
        <a asp-action="BacSi" class="btn btn-outline-secondary">← Quay lại</a>
    </div>
</div>

<div class="card" style="max-width:680px">
    <form method="post" asp-action="SuaBacSi" novalidate>
        @Html.AntiForgeryToken()
        <input asp-for="MaBacSi" type="hidden" />
        <div style="display:grid;grid-template-columns:1fr 1fr;gap:var(--space-md)">
            <div class="form-group">
                <label asp-for="HoTenBacSi" class="form-label"></label>
                <input asp-for="HoTenBacSi" class="form-control" />
                <span asp-validation-for="HoTenBacSi" class="field-validation-error"></span>
            </div>
            <div class="form-group">
                <label asp-for="HocVi" class="form-label"></label>
                <input asp-for="HocVi" class="form-control" />
            </div>
        </div>
        <div style="display:grid;grid-template-columns:1fr 1fr;gap:var(--space-md)">
            <div class="form-group">
                <label asp-for="SoDienThoai" class="form-label"></label>
                <input asp-for="SoDienThoai" class="form-control font-mono" />
                <span asp-validation-for="SoDienThoai" class="field-validation-error"></span>
            </div>
            <div class="form-group">
                <label asp-for="MaChuyenKhoa" class="form-label"></label>
                <select asp-for="MaChuyenKhoa" asp-items="ViewBag.ChuyenKhoaList" class="form-control">
                    <option value="">-- Chọn chuyên khoa --</option>
                </select>
                <span asp-validation-for="MaChuyenKhoa" class="field-validation-error"></span>
            </div>
        </div>
        <div class="form-group">
            <label asp-for="TrangThai" class="form-label"></label>
            <select asp-for="TrangThai" class="form-control">
                <option value="HoatDong">Hoạt động</option>
                <option value="NgungHoatDong">Ngừng hoạt động</option>
            </select>
        </div>
        <div class="btn-list" style="margin-top:var(--space-lg)">
            <button type="submit" class="btn btn-primary">Cập nhật</button>
            <a asp-action="BacSi" class="btn btn-outline-secondary">Hủy</a>
        </div>
    </form>
</div>

@section Scripts { <partial name="_ValidationScriptsPartial" /> }
