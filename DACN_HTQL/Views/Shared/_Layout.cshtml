<!DOCTYPE html>
<html lang="vi" data-portal="patient">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>@ViewData["Title"] — Phòng Khám Đa Khoa</title>
  <meta name="description" content="@(ViewData["Description"] ?? "Đặt lịch khám online nhanh chóng, tiện lợi")" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin="anonymous" />
  <link rel="stylesheet" href="~/css/clinic.css" asp-append-version="true" />
  @await RenderSectionAsync("Styles", required: false)
</head>
<body style="min-height:100vh;display:flex;flex-direction:column;margin:0">
  <a class="skip-link" href="#main-content">Bỏ qua điều hướng</a>

  <header>
    <nav class="site-nav" id="site-nav" aria-label="Điều hướng chính">
      <div class="container">
        <div class="site-nav__row">
          <a class="site-nav__brand" asp-controller="Home" asp-action="Index">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M22 12h-4l-3 9L9 3l-3 9H2"/></svg>
            <span>Phòng Khám Đa Khoa</span>
          </a>
          <div class="site-nav__end">
            @if (User.Identity?.IsAuthenticated == true)
            {
              <div class="btn-list" style="align-items:center">
                @if (User.IsInRole("Admin"))
                {
                  <a class="btn btn-sm btn-outline-primary" asp-controller="Admin" asp-action="Index">Cổng Admin</a>
                }
                else if (User.IsInRole("LeTan"))
                {
                  <a class="btn btn-sm btn-outline-primary" asp-controller="LeTan" asp-action="Index">Cổng Lễ tân</a>
                }
                else if (User.IsInRole("BacSi"))
                {
                  <a class="btn btn-sm btn-outline-primary" asp-controller="BacSi" asp-action="Index">Màn hình Bác sĩ</a>
                }
                <form asp-controller="TaiKhoan" asp-action="DangXuat" method="post" style="display:inline">
                  @Html.AntiForgeryToken()
                  <button type="submit" class="btn btn-sm btn-outline-secondary">Đăng xuất</button>
                </form>
              </div>
            }
            else
            {
              <div class="btn-list">
                <a class="btn btn-sm btn-outline-secondary" asp-controller="TaiKhoan" asp-action="DangNhap">Đăng nhập</a>
                <a class="btn btn-sm btn-primary" asp-controller="TaiKhoan" asp-action="DangKy">Đăng ký</a>
              </div>
            }
          </div>
        </div>
      </div>
    </nav>
  </header>

  <main id="main-content" style="flex:1 0 auto;display:flex;flex-direction:column">
    @if (TempData["SuccessMessage"] != null)
    {
      <div class="container" style="padding-top:var(--space-md)">
        <div class="alert alert--success" role="alert">
          <svg width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true"><polyline points="20 6 9 17 4 12"/></svg>
          <span>@TempData["SuccessMessage"]</span>
        </div>
      </div>
    }
    @if (TempData["ErrorMessage"] != null)
    {
      <div class="container" style="padding-top:var(--space-md)">
        <div class="alert alert--error" role="alert">
          <svg width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/></svg>
          <span>@TempData["ErrorMessage"]</span>
        </div>
      </div>
    }
    @RenderBody()
  </main>

  <footer style="margin-top:auto;flex-shrink:0;border-top:1px solid var(--color-rule);background:#ffffff;padding-block:var(--space-xl)">
    <div class="container">
      <div style="display:flex;align-items:center;justify-content:space-between;gap:var(--space-lg);flex-wrap:wrap">
        <span style="font-weight:700;font-size:var(--text-md);letter-spacing:var(--tracking-display);color:var(--color-ink)">Phòng Khám Đa Khoa</span>
        <span class="text-sm text-muted">© @DateTime.Now.Year — Hệ thống Quản lý Khám Chữa Bệnh</span>
      </div>
    </div>
  </footer>

  <script src="~/lib/jquery/dist/jquery.min.js"></script>
  <script src="~/lib/jquery-validation/dist/jquery.validate.min.js"></script>
  <script src="~/lib/jquery-validation-unobtrusive/dist/jquery.validate.unobtrusive.min.js"></script>
  <script>
    const nav = document.getElementById('site-nav');
    if (nav) {
      window.addEventListener('scroll', () =>
        nav.classList.toggle('is-scrolled', window.scrollY > 10), { passive: true });
    }
  </script>
  @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
